# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret — tuyệt đối không nướng vào image
.env
.env.*
*.pem
*.key

# Lịch sử git: nặng và không có tác dụng gì lúc chạy
.git
.gitignore
.github

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# Chỉ dùng lúc phát triển, không thuộc về runtime
tests/
screenshots/
*.md
grade.py
docker-compose.yml
nginx/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
